# Copy to .env if you want local overrides. Never commit .env.
# This desk does not read these values into order calls.
# Public monitors (snapshot, scan, paper-status) work with every secret left blank.

# Bybit HMAC API key and secret. Placeholders only — do not put real keys in git.
# The included programs do not sign requests and do not place orders.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional id of a Bybit subaccount you might use later by hand.
# Not sent anywhere by this repository.
BYBIT_AI_SUBACCOUNT_ID=

# Public REST host. Market data only.
BYBIT_BASE_URL=https://api.bybit.com

# Paper bankroll in USDT. ~US$20 tracks the ~R$100 Pix-funded experiment.
# BRL itself is deposited by a human via Pix; this repo has no Pix client.
DESK_PAPER_EQUITY_USDT=20

# Display-only hint so paper USDT can be read next to reais. Not a live FX feed.
DESK_BRL_PER_USDT=5

# Where paper-status --init writes the simulated ledger. Gitignored.
DESK_LEDGER_PATH=data/paper_ledger.json

# Comma-separated USDT spot symbols for the monitors.
DESK_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Human yes-word for the manual ticket helper.
# Default false. Only the exact word "yes" unlocks a text ticket.
# "yes" still does not transmit an order. There is no live order code path.
LIVE_ORDERS_CONFIRM=false
